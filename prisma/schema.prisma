generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Prospect {
  id               String         @id @default(uuid())
  name             String
  city             String
  country          String         @default("France")
  targetType       String         @map("target_type")
  industry         String?
  propertyType     String?        @map("property_type")
  address          String?
  description      String?
  source           String
  sourceUrl        String         @map("source_url")
  website          String?
  email            String?
  phone            String?
  instagram        String?
  facebook         String?
  linkedin         String?
  tiktok           String?
  twitter          String?
  priority         String         @default("medium")
  status           String         @default("new")
  confidence       String         @default("medium")
  interestLevel    String?        @map("interest_level")
  willingToPay     Boolean        @default(false) @map("willing_to_pay")
  notes            String?
  signals          String?        // JSON array of signal objects
  technologyStack  String?        @map("technology_stack") // JSON array
  angle            String?
  nextAction       String?        @map("next_action")
  googleRating     Float?         @map("google_rating")
  reviewCount      Int?           @map("review_count")
  placeId          String?        @map("place_id")
  scrapeRunId      String?        @map("scrape_run_id")
  nextFollowUpDate DateTime?      @map("next_follow_up_date")
  lastSeenAt       DateTime?      @map("last_seen_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  prospectNotes    ProspectNote[]
  scrapeRun        ScrapeRun?     @relation(fields: [scrapeRunId], references: [id])

  @@map("prospects")
}

model ProspectNote {
  id         String   @id @default(uuid())
  prospectId String   @map("prospect_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@map("prospect_notes")
}

model ScrapeRun {
  id                String    @id @default(uuid())
  targetDescription String    @map("target_description")
  location          String    @default("")
  country           String    @default("France")
  industry          String?
  keywords          String?
  negativeKeywords  String?   @map("negative_keywords")
  sourcesUsed       String    @map("sources_used")
  maxResults        Int       @default(50) @map("max_results")
  maxPagesPerSite   Int       @default(3) @map("max_pages_per_site")
  status            String    @default("running")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  pagesAnalyzed     Int       @default(0) @map("pages_analyzed")
  leadsFound        Int       @default(0) @map("leads_found")
  leadsSaved        Int       @default(0) @map("leads_saved")
  errors            String?
  createdAt         DateTime  @default(now()) @map("created_at")

  logs      ScrapeLog[]
  prospects Prospect[]

  @@map("scrape_runs")
}

model ScrapeLog {
  id          String   @id @default(uuid())
  scrapeRunId String   @map("scrape_run_id")
  level       String
  message     String
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")

  scrapeRun ScrapeRun @relation(fields: [scrapeRunId], references: [id], onDelete: Cascade)

  @@map("scrape_logs")
}

model SearchRun {
  id            String   @id @default(uuid())
  query         String
  city          String
  country       String   @default("France")
  targetType    String   @map("target_type")
  sourcesUsed   String   @map("sources_used")
  resultsFound  Int      @default(0) @map("results_found")
  contactsSaved Int      @default(0) @map("contacts_saved")
  errors        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("search_runs")
}
